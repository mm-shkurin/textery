# Base URL for the generation API. Leave empty to route through the Vite
# dev server's /api proxy (see vite.config.ts).
VITE_API_BASE_URL=

# Target the dev proxy forwards /api requests to. REQUIRED — there is no default.
#
# It is whatever address your backend is actually listening on. Two ways to get one:
#
#   * Run the backend from its own repository (https://gitverse.ru/studentlabs/slide_backend):
#     `docker compose up --build` there publishes it, and BACKEND_PORT in that repo's .env is
#     the port. Typically:
#         VITE_API_PROXY_TARGET=http://localhost:8001
#
#   * Inside the monorepo, where the whole stack comes up together, the port is assigned per
#     checkout so that parallel checkouts do not collide:
#         grep BACKEND_PORT ../infra/.env
#
# Never 8000 — another service holds that port on this host, so a wrong value there proxies to
# someone else's app instead of failing. Leaving this empty stops the dev server with the fix
# in the message, which is the point: a baked-in address fails silently instead.
VITE_API_PROXY_TARGET=

# Port the dev server listens on.
FRONTEND_PORT=5173

# Generation polling cadence. The client asks a running generation for its status every
# INTERVAL ms, at most MAX_ATTEMPTS times (their product is the ceiling on one generation),
# and gives up after MAX_FAILURES consecutive failed checks. Defaults are what the product
# was tested against — set these only when a stand needs a different cadence.
VITE_GENERATION_POLL_INTERVAL_MS=
VITE_GENERATION_POLL_MAX_ATTEMPTS=
VITE_GENERATION_POLL_MAX_FAILURES=

# Autosave backoff in the editor: first retry after BASE ms, doubling up to MAX ms.
VITE_AUTOSAVE_RETRY_BASE_MS=
VITE_AUTOSAVE_RETRY_MAX_MS=

# Image formats an avatar may be uploaded in, comma separated. Widening this without the backend
# accepting the format will surface as a rejected upload.
VITE_AVATAR_TYPES=

# How long an analytics report may stay on the wire, in ms. Far below the product's own 25s
# request bound on purpose: nobody waits on a telemetry POST, and a hung one holds one of the
# browser's few per-host connections while the app's own calls queue behind it.
VITE_ANALYTICS_TIMEOUT_MS=
