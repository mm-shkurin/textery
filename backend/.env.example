# backend/.env.example — copy to backend/.env and fill in real values for local dev.
#
# backend/.env is gitignored (repo root .gitignore has a blanket `.env` rule) —
# never commit it. This file documents every var the backend containers
# consume, wired in via `env_file` in infra/docker-compose.yml. See
# infra/architecture.md for the full container-wiring contract.

# --- Connection ---
# The PostgreSQL connection string, read by adapters/db/src/session.py. Set by
# `environment:` in infra/docker-compose.yml rather than through this file, which
# is why it was undocumented until 2026-08-07 — but the README tells you to run
# `uvicorn` directly for local development, and outside compose nothing sets it.
DATABASE_URL=postgresql+asyncpg://textery:change-me@localhost:5432/textery

# --- API documentation ---
# Publishes /docs, /redoc and /openapi.json. OFF unless set to one of
# 1/true/yes/on — anything else, including "false" and "0", leaves it off.
#
# The default is closed because the backend port is published on the host
# (infra/docker-compose.yml `${BACKEND_PORT}:8000`), so these paths bypass nginx,
# which proxies only /api/. Enabled here because local development is where the
# Swagger UI is wanted; a deployment that wants it says so explicitly.
API_DOCS_ENABLED=1

# --- Generation provider ---
# Defaults to "gigachat" (GigaChatProvider, needs GIGACHAT_CREDENTIALS below).
# Set to "fake" to run without real credentials (FakeProvider, canned content).
GENERATION_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=change-me
# Overrides the bundled Russian trust-CA PEM (adapters/generation_provider/certs)
# if GigaChat's cert chain changes. Usually leave unset.
# GIGACHAT_CA_BUNDLE=/path/to/ca-bundle.pem

# --- Auth / JWT ---
# HS256 signing key for access and refresh tokens. REQUIRED — the app refuses to
# start without it, deliberately: a default here would ship a signing key that is
# public in the git history, making every token in production forgeable by anyone
# who read the repo. Must be at least 32 bytes (RFC 7518 §3.2 for HS256) — a
# shorter key is brute-forceable offline from one captured token, so the app
# refuses that too rather than running visibly-fine and quietly forgeable.
# Generate with: openssl rand -hex 32
# Rotating it invalidates every issued token (tokens are stateless, so there is
# no revocation list to clear) — every client must log in again.
JWT_SECRET=change-me

# --- Generation sweep ---
# How long a generation may sit in pending/in_progress before the periodic sweep
# treats it as stranded and re-runs it. Defaults to 10.
# GENERATION_STALE_AFTER_MINUTES=10

# --- Database (this repository's own docker-compose.yml) ---
# Read by backend/docker-compose.yml, which is what the PUBLISHED repository is
# started with: it composes DATABASE_URL from these plus the in-network service
# name (postgres), and refuses to start without a password rather than inventing
# one. The README's «cp .env.example .env» step named POSTGRES_PASSWORD while
# this file did not carry it, so `docker compose up --build` aborted with
# "required variable POSTGRES_PASSWORD is missing a value" on a fresh clone.
#
# In the MONOREPO the same values come from infra/.env instead — infra's compose
# file has its own copy, and neither reads this one.
POSTGRES_PASSWORD=
# POSTGRES_USER=textery
# POSTGRES_DB=textery
# POSTGRES_PORT=5432
#
# No REDIS_URL: the backend reads no such variable and has no Redis client in
# requirements.txt. It was listed here, in the README, and installed by CI, all
# for a dependency that does not exist.

# --- Logging ---
# Root log level. Defaults to INFO — at WARNING the two exception handlers that
# record a refused 404/409 go silent, and those are the lines that answer
# "did the client ever reach us" during an incident. An unrecognised value falls
# back to INFO rather than refusing to boot: unlike DATABASE_URL and JWT_SECRET,
# a wrong value here has a safe answer, and a typo in an observability knob must
# not become downtime.
# LOG_LEVEL=INFO

# --- OAuth (Yandex ID) ---
# CLIENT_ID and CLIENT_SECRET are validated at import, exactly like JWT_SECRET:
# without them the application does NOT start. That is deliberate (invariant I7) —
# a blank credential should be a boot failure naming the variable, never a
# half-configured process that 500s on the first sign-in.
#
# The check runs unconditionally. Setting OAUTH_PROVIDER=fake swaps only how the
# identity is fetched; it does not waive the deployment's configuration.
YANDEX_CLIENT_ID=change-me
YANDEX_CLIENT_SECRET=change-me
# Where Yandex sends the browser back. REQUIRED — no default in code: a fallback
# of http://localhost/auth/callback meant a misconfigured deployment sent the
# one-time handoff code, which exchanges for a token pair, over plaintext HTTP to
# a host that is not the frontend.
YANDEX_REDIRECT_URI=https://change-me.example/auth/callback

# `yandex` (default) or `fake` — sign in without a real provider.
# OAUTH_PROVIDER=yandex
# Where the fake provider sends the browser on step 1. Read ONLY when
# OAUTH_PROVIDER=fake, and required in that case — a stub URL compiled into the
# image as a default is one mis-set OAUTH_PROVIDER away from being where a real
# sign-in is sent.
# OAUTH_FAKE_AUTHORIZE_URL=
# Frontend page the one-time handoff code is delivered to. REQUIRED, same reason
# as YANDEX_REDIRECT_URI.
OAUTH_FRONTEND_CALLBACK_URL=https://change-me.example/auth/callback
# Lifetime of that handoff code, in seconds.
# OAUTH_HANDOFF_CODE_TTL_SECONDS=
# Best-effort abuse bound per source, not an auth boundary.
# OAUTH_RATE_LIMIT_MAX_REQUESTS=
# OAUTH_RATE_LIMIT_WINDOW_SECONDS=
