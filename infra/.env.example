# infra/.env.example — copy to infra/.env and fill in real values for local dev.
#
# infra/.env is gitignored (repo root .gitignore has a blanket `.env` rule) —
# never commit it. This file documents every var docker-compose.yml consumes.
#
# Backend secrets are NOT set here — GIGACHAT_CREDENTIALS, GIGACHAT_CA_BUNDLE,
# GENERATION_PROVIDER and JWT_SECRET live in backend/.env (also gitignored) and are
# loaded into the `backend` container via `env_file` in docker-compose.yml. See
# infra/architecture.md for the full contract.
#
# (Until 2026-08-15 this line named OPENROUTER_API_KEY and a `worker` container.
# The provider became GigaChat on 2026-07-09 and no worker service exists —
# generation runs inline on FastAPI BackgroundTasks.)

# --- Postgres ---
POSTGRES_USER=textery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=textery
# Host-side port only; the container always listens on 5432 internally.
POSTGRES_PORT=5432

# --- Redis ---
# Host-side port only; the container always listens on 6379 internally.
REDIS_PORT=6379

# --- Backend ---
# Host-side port for the backend API; the container always listens on 8000 internally.
BACKEND_PORT=8000
# DATABASE_URL and REDIS_URL are NOT set here — docker-compose.yml composes them
# from the vars above plus the in-network service DNS names (postgres, redis),
# e.g. postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# and redis://redis:6379/0. That composition only works inside compose's own
# ${...} interpolation, not inside a plain .env file, so it lives in the compose
# file's `environment:` blocks instead.

# --- OAuth (Yandex ID) ---
# Consumed by docker-compose.yml and forwarded into the backend container. The first
# four are declared there WITHOUT defaults on purpose: an unset value must fail at boot
# naming the variable, not at the first sign-in attempt.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Where Yandex sends the browser back — must match the value registered in the Yandex
# app, e.g. http://localhost:${BACKEND_PORT}/api/v1/auth/oauth/yandex/callback
YANDEX_REDIRECT_URI=
# Where the backend hands the browser off after the callback, e.g.
# http://localhost:${FRONTEND_PORT}/auth/callback
OAUTH_FRONTEND_CALLBACK_URL=
# `yandex` for real sign-in, `fake` for the in-process stub the OAuth acceptance suite
# selects. VK ID is in the contract enum but has no credentials and answers a named error.
OAUTH_PROVIDER=yandex
# Handoff-code lifetime. NEVER leave this empty: `${VAR:-}` forwards an empty string,
# which is present-but-empty in the container, so `int("")` kills the process at import.
OAUTH_HANDOFF_CODE_TTL_SECONDS=300
# Read only under OAUTH_PROVIDER=fake.
OAUTH_FAKE_AUTHORIZE_URL=http://localhost/auth/fake-provider

# --- Frontend ---
# Host-side port; the container always listens on 80 internally.
FRONTEND_PORT=80
